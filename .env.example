# Controller-only CLI configuration; this file is not loaded automatically.
# Keep values server-side; never use a VITE_ prefix for credentials.
# The only allowed base URL; any override is rejected.
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
# Optional when an exact approved plan already specifies the model.
VULTR_INFERENCE_MODEL=
# A key alone does not authorize spending. See docs/inference.md for the required
# local approval plan, request/token bounds, prices and durable spending ledger.
# The web scaffold does not expose execution or sending.
